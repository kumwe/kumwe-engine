file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
file(WRITE "${TEST_DIRECTORY}/compile.json" "{\"wire_version\":1,\"profile\":\"formula-draft/1\",\"corpus_digest\":\"${FORMULA_CORPUS}\",\"program\":{\"op\":\"field\",\"type\":\"integer\",\"field\":\"amount\"}}")
file(WRITE "${TEST_DIRECTORY}/batch.json" [=[{"wire_version":1,"documents":[{"correlation":"cli.1","fields":{"amount":9007199254740993},"lines":{}}],"limits":{"max_input_bytes":10000,"max_output_bytes":10000,"max_documents":10,"max_findings":10,"max_instructions":100000,"max_milliseconds":30000}}]=])
file(WRITE "${TEST_DIRECTORY}/canonical.json" "{\"wire_version\":1,\"profile\":\"kumwe-canonical-json/generic-v1\",\"operation\":\"encode\",\"corpus_digest\":\"${CANONICAL_CORPUS}\",\"input\":{\"type\":\"int\",\"decimal\":\"9007199254740993\"}}")
file(WRITE "${TEST_DIRECTORY}/malformed.json" "{")
function(run_success)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT error STREQUAL "")
    message(FATAL_ERROR "Diagnostic invocation failed: ${status}: ${error}")
  endif()
  string(JSON kind TYPE "${output}")
  if(NOT kind STREQUAL "OBJECT")
    message(FATAL_ERROR "Diagnostic output is not a JSON object")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
endfunction()
run_success(--capabilities)
string(JSON owner GET "${last_output}" engine)
if(NOT owner STREQUAL "kumwe/engine")
  message(FATAL_ERROR "Capabilities came from a different runtime")
endif()
string(JSON advertised_corpora LENGTH "${last_output}" corpora)
string(JSON first_corpus GET "${last_output}" corpora 0 path)
run_success(--verify-bundle "${CORPUS_DIRECTORY}")
string(JSON corpus_count LENGTH "${last_output}" corpora)
if(NOT corpus_count EQUAL advertised_corpora OR corpus_count LESS 6)
  message(FATAL_ERROR "Diagnostic did not verify every native corpus")
endif()
run_success(--compile "${TEST_DIRECTORY}/compile.json")
string(JSON compiled_profile GET "${last_output}" profile)
if(NOT compiled_profile STREQUAL "formula-draft/1")
  message(FATAL_ERROR "Compiled plan identity changed")
endif()
run_success(--execute "${TEST_DIRECTORY}/compile.json" "${TEST_DIRECTORY}/batch.json")
# Inspect the decimal spelling, since some JSON test tooling itself rounds large integers.
if(NOT last_output MATCHES "\"value\":9007199254740993" OR NOT last_output MATCHES "\"correlation\":\"cli.1\"")
  message(FATAL_ERROR "Batch did not preserve the exact integer or correlation")
endif()
run_success(--canonical "${TEST_DIRECTORY}/canonical.json")
string(JSON canonical GET "${last_output}" output)
if(NOT canonical STREQUAL "9007199254740993")
  message(FATAL_ERROR "Canonical output bytes differ")
endif()
execute_process(COMMAND "${CLI}" --canonical - INPUT_FILE "${TEST_DIRECTORY}/canonical.json"
  RESULT_VARIABLE status OUTPUT_VARIABLE piped ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT piped STREQUAL last_output OR NOT error STREQUAL "")
  message(FATAL_ERROR "Standard input changed native canonical output")
endif()
execute_process(COMMAND "${CLI}" --compile "${TEST_DIRECTORY}/malformed.json"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 1 OR NOT output STREQUAL "{\"status\":1}\n" OR NOT error STREQUAL "")
  message(FATAL_ERROR "Malformed compile did not preserve native refusal status")
endif()
execute_process(COMMAND "${CLI}" --execute - - RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT output STREQUAL "")
  message(FATAL_ERROR "Ambiguous standard input was accepted")
endif()
string(REGEX REPLACE "^corpus/" "" first_relative "${first_corpus}")
get_filename_component(first_directory "${first_relative}" DIRECTORY)
file(MAKE_DIRECTORY "${TEST_DIRECTORY}/invalid-corpus/${first_directory}")
file(WRITE "${TEST_DIRECTORY}/invalid-corpus/${first_relative}" "changed")
execute_process(COMMAND "${CLI}" --verify-bundle "${TEST_DIRECTORY}/invalid-corpus"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 4 OR NOT output STREQUAL "{\"status\":4}\n" OR NOT error STREQUAL "")
  message(FATAL_ERROR "Altered corpus identity was accepted")
endif()
message(STATUS "Diagnostic CLI compile, execution, canonical bytes, corpus identity and input/refusal checks passed")
